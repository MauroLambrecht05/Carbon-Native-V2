# Carbon Native V2 Root Build File

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_clippy_test", "cargo_fmt", "cargo_fmt_test")

# ── Quality gates ───────────────────────────────────────────────────────────
# Bazel is the entrypoint in this workspace, so formatting and lints have to be
# Bazel targets — otherwise they are things only a separate task runner could
# invoke, which in practice means things that never run. Both are `bazel test`
# targets, so `bazel test //...` gates on them.
#
#   bazel test //:fmt_test      is the tree rustfmt-clean?
#   bazel run  //:fmt           make it so
#   bazel test //:clippy_test   clippy with -D warnings
#
# The clippy allow-list lives in [workspace.lints.clippy] in
# .tools/orchestration/bazel/cargo/Cargo.toml, named lint by lint with a reason and a count, so the
# inherited debt is countable rather than hidden behind -A clippy::all.

# size = "large" (900s, default is "medium"/300s): confirmed timing out under
# real CI parallelism (bazel test //... runs ~30 actions at once, and this one
# does a fresh rustup toolchain sync each invocation) — "-- Test timed out --"
# on a real run, immediately followed by cargo-fmt genuinely not being
# installed yet. Not a fmt_test bug; a CI-parallelism headroom problem.
cargo_fmt_test(
    name = "fmt_test",
    size = "large",
)

cargo_fmt(name = "fmt")

cargo_clippy_test(name = "clippy_test")

package_group(
    name = "carbon_internal",
    packages = [
        "//labs/...",
        "//products/...",
        "//solutions/...",
    ],
)

package_group(
    name = "contracts",
    packages = [
        "//solutions/shared/contracts/...",
    ],
)

filegroup(
    name = "all_config_files",
    srcs = glob([".config/**"]),
)

filegroup(
    name = "all_tools",
    srcs = glob([".tools/**"]),
)
