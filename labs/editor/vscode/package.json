{
  "name": "@carbon/vscode",
  "displayName": "Carbon CTSX",
  "description": "Syntax highlighting for carbon-mini's .ctsx entry files (the @CarbonApp DSL).",
  "version": "0.1.10",
  "publisher": "carbon-mini",
  "private": true,
  "icon": "icons/logo.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ctsx",
        "aliases": [
          "Carbon CTSX",
          "ctsx"
        ],
        "extensions": [
          ".ctsx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/logo.png",
          "dark": "./icons/logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ctsx",
        "scopeName": "source.ctsx",
        "path": "./syntaxes/ctsx.tmLanguage.json"
      }
    ]
  }
}
