// The SDK is referenced by path, not fetched: it lives in this workspace and
// a plugin built against a downloaded copy would be built against a different
// extension-point registry than the runtime it loads into.
.{
    .name = .carbon_crt,
    // Identifies this package across renames — zig's own suggested value for
    // this exact name, taken from a real `zig build` error, not guessed.
    .fingerprint = 0x2c2039bce96e3976,
    .version = "0.1.0",
    .minimum_zig_version = "0.13.0",
    .dependencies = .{
        .@"carbon-plugin-sdk" = .{
            .path = "../../../../../products/carbon-ext/composition",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "carbon-plugin.toml",
    },
}
