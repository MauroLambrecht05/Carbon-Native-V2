# Carbon Native V2 - @carbon/packaging
#
# Capability: an artifact into an OS installer definition.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

# 19 tests. The first this capability has had — it arrived from V1 as five
# generators nothing called, so there was no way in to test through.
bun_test(
    name = "packaging_integration_test",
    entry = "tests/packaging.integration.test.ts",
    srcs = [":srcs", ":tests"],
)
