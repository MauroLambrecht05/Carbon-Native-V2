# Carbon Native V2 - @carbon/updating
#
# Capability: keeping an installed app current without bricking it.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts", "**/*.js"], exclude = ["**/*.test.ts", "**/*.selftest.js"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

# Pure domain — no filesystem, no network.
bun_test(name = "rollout_test", entry = "domain/services/RolloutService.test.ts", srcs = [":srcs", ":tests"])
bun_test(name = "slot_state_test", entry = "domain/entities/SlotState.test.ts", srcs = [":srcs", ":tests"])

# The lifecycle that actually ships: stage, promote, crash, roll back — with
# the file-backed repository, so the TOML round trip is exercised too.
bun_test(
    name = "slot_lifecycle_integration_test",
    entry = "tests/slot-lifecycle.integration.test.ts",
    srcs = [":srcs", ":tests"],
)

# The shared update conformance fixture (//solutions/contracts/update), run by
# the TypeScript updater here and by the Rust updater below.
bun_test(
    name = "conformance_test",
    entry = "tests/conformance.test.ts",
    srcs = [":srcs", ":tests", "//solutions/contracts/update:fixtures"],
)

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_test")

filegroup(
    name = "rust_srcs",
    srcs = glob(["rust/**/*.rs", "rust/Cargo.toml"], allow_empty = True),
)

# The Rust updater's unit tests and the same conformance fixture. This is the
# updater packaged apps run. size = "large": on a cold Cargo cache the target
# waits on the shared build directory while other crates compile.
cargo_test(
    name = "rust_updater_test",
    package = "carbon-updater",
    srcs = [":rust_srcs", "//solutions/contracts/update:fixtures"],
    size = "large",
)
