[package]
name = "@@NAME@@"
version = "0.1.0"
edition = "2021"

[lib]
# `cdylib` produces a `.dll` (Windows), `.so` (Linux), or `.dylib` (macOS)
# that carbon-mini can dlopen. The crate name is what determines the output
# filename; underscores in the crate name become underscores in the file
# (e.g., `my_plugin` → `my_plugin.dll`).
crate-type = ["cdylib"]

[dependencies]
# Path dep into the carbon-native workspace. When carbon-plugin-sdk lands
# on crates.io, change this to:
#   carbon-plugin-sdk = "0.1"
carbon-plugin-sdk = { path = "@@SDK_PATH@@" }

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
strip = "symbols"
