# Plugin manifest used by `carbon plugin info` and `carbon plugin install`.
# Mirrors what `manifest()` in src/lib.rs returns; both must agree.
name = "@@NAME@@"
version = "0.1.0"
language = "rust"

[abi]
major = 1
minor = 0

[capabilities]
# Hard requirements — carbon-mini refuses to load the plugin if the host
# app's `carbon.toml [plugins]` block doesn't grant these.
required = []
# Best-effort capabilities — granted if the host allows them, ignored if not.
optional = ["fs.read"]

# JS module names the plugin exports. The carbon-fast-import build plugin
# resolves `import "carbon:@@NAME@@"` against this list.
modules = ["carbon:@@NAME@@"]

# Lifecycle hooks the plugin actually implements. Carbon-mini still uses
# dlsym to find them; this is informational.
hooks = ["register"]
