//! @@NAME@@ — a Carbon plugin scaffolded by `carbon plugin new`.
//!
//! Build with `carbon plugin build` (debug) or `carbon plugin build --release`.
//! Install into the host app with `carbon plugin install`, then list
//! `[plugins] @@NAME@@ = "<path-to-dll>"` in the app's `carbon.toml`.

use carbon_plugin_sdk::{capability::{Capability, Manifest}, carbon_plugin, CarbonApp};

/// Called once after carbon-mini has loaded and verified the plugin.
/// Install JS-visible globals here, register classes, spawn threads, etc.
fn register(app: &mut CarbonApp) {
    // Example: install a string global so user JS can do
    //   console.log(globalThis.hello_from_@@NAME@@);
    let _ = app.set_global_string(
        "hello_from_@@NAME@@",
        "@@NAME@@ plugin loaded",
    );
}

/// Manifest returned to carbon-mini before `register` is called.
/// Carbon-mini parses it, checks capability grants in the host app's
/// `carbon.toml [plugins]`, and aborts the load if anything required
/// isn't granted.
fn manifest() -> Manifest {
    Manifest::new("@@NAME@@", "0.1.0")
        // Declare capabilities the plugin actually uses. Remove or add as
        // appropriate; required ones must be granted in the host app's
        // carbon.toml or load fails.
        .optional_capability(Capability::FsRead)
        // Declare a JS module name the plugin exports. Lets users write
        //   import { thing } from "carbon:@@NAME@@";
        // (resolved at build time by the carbon-fast-import plugin).
        .module("carbon:@@NAME@@")
        .hook("register")
}

// Generate the C ABI entry points (`carbon_plugin_register` and
// `carbon_plugin_manifest`) carbon-mini calls into. Add more lines here to
// implement optional lifecycle hooks:
//
//     carbon_plugin! {
//         register: register,
//         manifest: manifest,
//         before_paint: my_before_paint,
//         on_shutdown: my_shutdown,
//     }
carbon_plugin! {
    register: register,
    manifest: manifest,
}
