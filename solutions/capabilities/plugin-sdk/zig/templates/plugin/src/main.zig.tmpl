// @@NAME@@ — Carbon plugin scaffolded by `carbon plugin new --lang zig`.
//
// Build:        zig build
// Install:      carbon plugin install
// Use from JS:  globalThis.hello_from_@@NAME@@

const std = @import("std");
const sdk = @import("carbon_sdk");

// Cached manifest JSON. Built once at comptime so we can return a stable
// pointer from `carbon_plugin_manifest`.
const MANIFEST_JSON = sdk.buildManifestJson(.{
    .name = "@@NAME@@",
    .version = "0.1.0",
    .optional = &.{"fs.read"},
    .modules = &.{"carbon:@@NAME@@"},
    .hooks = &.{"register"},
}) ++ &[_]u8{0}; // NUL-terminate for C consumers.

export fn carbon_plugin_register(app_raw: *sdk.RawApp) callconv(.C) void {
    const app = sdk.CarbonApp.fromRaw(app_raw);
    if (!app.abiCompatible()) return;

    _ = app.setGlobalString(
        "hello_from_@@NAME@@",
        "@@NAME@@ plugin loaded",
    );
}

export fn carbon_plugin_manifest() callconv(.C) [*:0]const u8 {
    return @ptrCast(MANIFEST_JSON.ptr);
}
