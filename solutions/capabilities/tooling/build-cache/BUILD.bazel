# Carbon Native V2 - @carbon/build-cache
#
# Rust port of BuildCache.ts's two-layer bundle cache key computation, for
# products/carbon-launcher — see that crate's own Cargo.toml header. Rust-only,
# so everything is under rust/, the same layout plugin/trust/rust uses.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library")

filegroup(
    name = "srcs",
    srcs = glob(["rust/**/*.rs", "rust/Cargo.toml"], allow_empty = True),
)

# No unit tests yet (see lib.rs) — this target exists so `bazel build //...`
# actually compiles this crate on its own, not only transitively the moment
# something builds carbon-launcher.
cargo_library(
    name = "build_cache",
    package = "carbon-build-cache",
    srcs = [":srcs"],
)
