# Carbon Native V2 - @carbon/layout
#
# Capability: a tree of nodes and style props becomes positioned boxes.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library", "cargo_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.rs", "**/*.wgsl", "Cargo.toml"], exclude = ["tests/**"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
)

cargo_library(
    name = "lib",
    package = "carbon-layout",
    srcs = [":srcs"],
)

# 27 tests over css_parse — the first this crate has ever had. It arrived from
# V1 with 3,700 lines and zero coverage, and it decides where everything on
# screen ends up. css_parse is where an app author's strings become typed
# values: the layer most exposed to malformed input, and testable against
# literals with no window, device or scene.
#
# scene.rs is still uncovered. That is the next piece of work here.
cargo_test(
    name = "layout_test",
    package = "carbon-layout",
    srcs = [":srcs", ":tests"],
)
