# Carbon Native V2 - @carbon/gpu-canvas
#
# Capability: <canvas> GPU commands become draw calls on a real device.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library", "cargo_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.rs", "**/*.wgsl", "Cargo.toml"], exclude = ["tests/**"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
)

cargo_library(
    name = "lib",
    package = "carbon-gpu-canvas",
    srcs = [":srcs"],
)

# 30 inline tests across geometry, material, uniforms, executor and gpu.
# They exist in V1 and have never run there: the crate is excluded from
# `cargo test --workspace` (see V1's .config/justfile) because wgpu 27 wants
# rustc 1.88. Pinning the lockfile to V1's resolved wgpu-hal 26.0.6 and adding
# the serde_json dependency its manifest never declared makes them run.
cargo_test(
    name = "gpu-canvas_test",
    package = "carbon-gpu-canvas",
    srcs = [":srcs", ":tests"],
)
