# Carbon Native V2 - @carbon/gpu-canvas
#
# Capability: <canvas> GPU commands become draw calls on a real device.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library", "cargo_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.rs", "**/*.wgsl", "Cargo.toml"], exclude = ["tests/**"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
)

# ── BOTH TARGETS ARE `manual`, AND WHY ──────────────────────────────────────
# This crate does not build on the toolchain the workspace declares. Its wgpu
# stack requires rustc >= 1.88; .tools/orchestration/bazel/cargo/Cargo.toml declares rust-version
# 1.86 and the Bazel cargo launcher now pins RUSTUP_TOOLCHAIN to match, so
# `cargo` here reports:
#
#     error: rustc 1.86.0 is not supported by the following packages
#
# V1 hit exactly this and excluded the crate from build-all, test and clippy.
# The V2 migration notes recorded the problem as fixed — and it appeared to be,
# because nothing pinned the toolchain: the build silently used whatever
# `rustup default` was (1.96 on the machine this was written on), where wgpu is
# perfectly happy. Pinning the declared MSRV is what surfaced it again.
#
# So `manual`: `bazel build //...` and `bazel test //...` skip both, matching
# what the rest of the tree already does (the clippy scope and the Rust test
# scope both --exclude carbon-gpu-canvas). Build it deliberately, on a toolchain
# that supports it:
#
#     RUSTUP_TOOLCHAIN=1.88 bazel test //solutions/capabilities/gpu-canvas:all
#
# Two ways out, neither of which belongs in a migration commit: raise the
# workspace MSRV to 1.88 and re-verify every other crate against it, or hold
# wgpu at a release that supports 1.86. Until one is chosen, this is excluded
# honestly rather than passing because the pin was missing.
cargo_library(
    name = "lib",
    package = "carbon-gpu-canvas",
    srcs = [":srcs"],
    tags = ["manual"],
)

# 30 inline tests across geometry, material, uniforms, executor and gpu. They
# exist in V1 and have never run there. They do run — on >= 1.88; see above.
cargo_test(
    name = "gpu-canvas_test",
    package = "carbon-gpu-canvas",
    srcs = [":srcs", ":tests"],
    tags = ["manual"],
)
