# Carbon Native V2 - @carbon/layout
#
# Capability: a tree of nodes and style props becomes positioned boxes.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library", "cargo_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.rs", "**/*.wgsl", "Cargo.toml"], exclude = ["tests/**"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
)

cargo_library(
    name = "lib",
    package = "carbon-layout",
    srcs = [":srcs"],
)

# 101 tests: 27 over css_parse, 74 over scene.rs. This crate arrived from V1
# with 3,700 lines and zero coverage, and it decides where everything on
# screen ends up. css_parse is where an app author's strings become typed
# values: the layer most exposed to malformed input, testable against
# literals with no window, device or scene. scene.rs's tests extend that same
# bias one layer up — tree mutation, hit testing, scroll/damage bookkeeping
# and the text-input editor — by constructing taffy::Layout values directly
# instead of running a real layout pass, so none of it needs a window, a
# device, or the font engine either. compute_layout and the other methods
# that measure real glyphs via TextEngine are still uncovered; that belongs
# with carbon-text-renderer's own tests, not faked out here.
# size = "large" (900s, default "medium"/300s): TIMEOUT on a real CI run
# under full workspace parallelism — see products/carbon:launch_test's
# comment for the same reasoning.
cargo_test(
    name = "layout_test",
    package = "carbon-layout",
    srcs = [":srcs", ":tests"],
    size = "large",
)
