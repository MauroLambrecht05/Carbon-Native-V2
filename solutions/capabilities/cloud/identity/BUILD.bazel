# Carbon Native V2 - @carbon/identity
#
# Capability: accounts and API tokens for Carbon Cloud.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

bun_test(
    name = "identity_test",
    entry = "tests/identity.test.ts",
    srcs = [":srcs", ":tests"],
)

bun_test(
    name = "service_assertions_test",
    entry = "tests/service-assertions.test.ts",
    srcs = [":srcs", ":tests"],
    deps = ["//solutions/contracts/platform:srcs"],
)

bun_test(
    name = "totp_test",
    entry = "tests/totp.test.ts",
    srcs = [":srcs", ":tests"],
)

bun_test(
    name = "authorization_policy_test",
    entry = "tests/authorization-policy.test.ts",
    srcs = [":srcs", ":tests"],
    deps = ["//solutions/contracts/platform:srcs"],
)

bun_test(
    name = "assertion_authority_test",
    entry = "tests/assertion-authority.test.ts",
    srcs = [":srcs", ":tests"],
    deps = ["//solutions/contracts/platform:srcs"],
)
