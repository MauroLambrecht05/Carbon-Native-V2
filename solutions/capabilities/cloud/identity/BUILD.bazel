# Carbon Native V2 - @carbon/identity
#
# Capability: accounts and API tokens for Carbon Cloud.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

bun_test(
    name = "identity_test",
    entry = "tests/identity.test.ts",
    srcs = [":srcs", ":tests"],
)
