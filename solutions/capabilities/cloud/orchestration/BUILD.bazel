# Carbon Native V2 - @carbon/orchestration
#
# Capability: a repo + commit, turned into a tracked, claimable build.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

bun_test(
    name = "cloud_orchestration_test",
    entry = "tests/build.test.ts",
    srcs = [":srcs", ":tests"],
)
