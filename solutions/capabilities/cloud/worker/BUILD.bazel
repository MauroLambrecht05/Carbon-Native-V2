# Carbon Native V2 - @carbon/worker
#
# Capability: claim a build, run it, report back.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

bun_test(
    name = "cloud_workers_test",
    entry = "tests/run-job.test.ts",
    srcs = [":srcs", ":tests"],
)
