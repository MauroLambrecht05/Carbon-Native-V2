# Carbon Native V2 - @carbon/plugin-host

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_library", "cargo_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.rs", "**/*.js", "Cargo.toml"], allow_empty = True),
)

cargo_library(
    name = "lib",
    package = "carbon-plugin-host",
    srcs = [":srcs"],
)

# The manifest parser, the capability check and the cross-DLL allocator — the
# parts of this crate that are pure logic over the frozen ABI, and the only
# Rust test V1 had. It did not come across with the migration; this is the port.
#
# What is deliberately NOT here: loading a real .dll end to end. That was
# fragile across CI-vs-local and MSVC-vs-GNU in V1, and the assembled runtime is
# covered by //products/carbon:launch_test instead.
#
# The rest of this crate drives real OS facilities and stays untested here; its
# surface is checked by the host-boundary validator against contracts/runtime.
cargo_test(
    name = "plugin_loader_test",
    package = "carbon-plugin-host",
    srcs = [":srcs"],
)
