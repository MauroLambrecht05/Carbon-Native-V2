# Carbon Native V2 - @carbon/operations
#
# Infrastructure: redaction, metrics, readiness and request observation.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

filegroup(
    name = "srcs",
    srcs = glob(["**/*.ts"], exclude = ["**/*.test.ts"], allow_empty = True),
)

filegroup(
    name = "tests",
    srcs = glob(["**/*.test.ts"], allow_empty = True),
)

bun_test(
    name = "operations_test",
    entry = "tests/operations.test.ts",
    srcs = [":srcs", ":tests"],
)
