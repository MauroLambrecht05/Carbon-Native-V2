{
  "name": "@carbon/mini-react",
  "version": "0.2.0",
  "description": "React 19+ adapter for the carbon-mini desktop runtime. Maps react-reconciler HostConfig onto carbon-mini's __cm_* scene-graph host imports \u2014 no DOM required, no react-dom shipped.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./jsx-runtime": "./runtime/jsx-runtime.ts",
    "./jsx-dev-runtime": "./runtime/jsx-runtime.ts",
    "./types": "./types/index.d.ts"
  },
  "peerDependencies": {
    "react": ">=18.3.0"
  },
  "dependencies": {
    "react-reconciler": "^0.29.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-reconciler": "^0.28.9",
    "csstype": "^3.2.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
