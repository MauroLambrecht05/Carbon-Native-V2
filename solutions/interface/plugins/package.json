{
  "name": "@carbon/plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-facing wrappers around carbon-sdk's standard plugins — the ergonomic hook/function surface app code imports, as opposed to a plugin's raw carbon:* bridge.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./fonts": "./wrappers/fonts.ts",
    "./clipboard": "./wrappers/clipboard.ts",
    "./dialog": "./wrappers/dialog.ts",
    "./notification": "./wrappers/notification.ts",
    "./keychain": "./wrappers/keychain.ts",
    "./global-shortcuts": "./wrappers/global-shortcuts.ts",
    "./tray": "./wrappers/tray.ts",
    "./deep-link": "./wrappers/deep-link.ts"
  },
  "carbon": {
    "kind": "presentation"
  },
  "peerDependencies": {
    "react": ">=18.3.0"
  }
}
