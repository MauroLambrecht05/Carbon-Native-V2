module(
    name = "carbon_native",
    version = "0.1.0",
    compatibility_level = 1,
)

# Core Platform and Rules
# 0.0.9, not 0.0.8: a transitive dependency already pulls 0.0.9, and asking for
# 0.0.8 only produced a "root module requires … but got …" warning on every
# invocation without changing what was actually used.
bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_rust", version = "0.40.0")
bazel_dep(name = "rules_go", version = "0.46.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.35.0")
bazel_dep(name = "flatbuffers", version = "24.3.25")

# NOTE ON THE TYPESCRIPT TIER
#
# This module previously declared `rules_js` 1.38.0 and `rules_ts` 2.2.0. Both
# were wrong and neither ever resolved: in the Bazel Central Registry those
# modules are named `aspect_rules_js` / `aspect_rules_ts`, so `bazel query
# //...` failed at module resolution before reaching a single BUILD file.
# (`flatbuffers` was pinned to 23.5.26, which does not exist in the registry
# either — the earliest published version is 24.3.7.)
#
# They are not corrected, they are removed, because the TypeScript tier does
# not run on Node. carbon-cli is a Bun program: pipeline/index.ts drives
# Bun.build with a custom plugin adapter, doctor.ts imports `spawnSync` from
# "bun", and paths.ts detects Bun's compiled-binary VFS. rules_js supplies a
# Node toolchain, which would load the entrypoint and then die on the first
# `bun` import.
#
# Instead, Bazel drives Bun directly through the toolchain below.

# ── Bun toolchain ───────────────────────────────────────────────────────────
# A pinned, hermetic Bun. See .tools/orchestration/bazel/bun/README.md.
bun = use_extension("//.tools/orchestration/bazel/bun:extensions.bzl", "bun")
bun.toolchain(version = "1.3.10")
use_repo(bun, "bun_toolchains")

register_toolchains("@bun_toolchains//:all")

# The host's cargo, located once at fetch time. Nothing is downloaded — Rust
# cannot be made hermetic here without vendoring a C toolchain, since 123 of the
# runtime's transitive dependencies run build scripts (rquickjs-sys compiles
# QuickJS, ring assembles, ash/naga sit behind wgpu). See
# .tools/orchestration/bazel/cargo/README.md.
#
# This exists because `bazel test` scrubs the environment: a run-time search for
# ~/.cargo/bin cannot see USERPROFILE and reports a missing toolchain that is in
# fact installed. Repository rules run during fetch and do see the real env.
cargo = use_extension("//.tools/orchestration/bazel/cargo:extensions.bzl", "cargo")
use_repo(cargo, "carbon_cargo")

# ── Rust Toolchain ──────────────────────────────────────────────────────────
# Registered but NOT used to build anything today — cargo drives compilation
# (see the extension above). This stays as the escape hatch: if the build-script
# problem is ever solved, `rust_library` targets need a registered toolchain and
# this is it. Version tracks .config/dependencies.json.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.86.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ── Go Toolchain ────────────────────────────────────────────────────────────
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.0")
