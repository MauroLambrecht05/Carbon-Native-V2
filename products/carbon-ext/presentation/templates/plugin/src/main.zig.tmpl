// @@NAME@@ — a Carbon plugin, scaffolded by `carbon plugin new`.
//
//   zig build                 build it
//   carbon plugin install     copy it into the app and declare it
//   carbon plugin check       verify this file against the registry
//
// ── HOW A PLUGIN WORKS ──────────────────────────────────────────────────────
// A plugin implements an extension point by calling `sdk.ext.implement(id,
// func)` next to an ordinary `pub fn`. What that does depends on how this
// file gets compiled:
//   - Standalone (`zig build`, `carbon dev`'s whole pipeline — the default,
//     and everything this scaffold needs to know about): it exports `func`
//     as a real C symbol, and the runtime looks each one up by name after
//     dlopen'ing the shared library — a symbol it finds is an extension
//     point this plugin implements.
//   - As one plugin among several statically linked into a `carbon build
//     --release` binary: it exports nothing, because a generated "umbrella"
//     file calls `func` directly through its own `@import` of this file
//     instead — irrelevant to a plugin author, this file never changes
//     either way.
// Nothing is registered at runtime and there is no callback table to fill
// in — `sdk.ext.implement` IS the registration, either way.
//
// Which symbols exist, what each one is called and when the runtime calls it
// is the registry:
//
//   solutions/contracts/plugin/registry/extension-points.zig
//
// You can read it directly, or ask:
//
//   carbon ext list           every point, one line each
//   carbon ext show <id>      one point, with the Zig to implement it

const std = @import("std");
const sdk = @import("carbon_sdk");

// ── The manifest ────────────────────────────────────────────────────────────
//
// Returned to the runtime BEFORE any of this plugin's code runs, so the
// loader can check the ABI and the capability grants first. Built at comptime,
// so `.points` is checked against the registry when you compile: a misspelled
// id fails the build rather than producing a plugin that loads and does
// nothing.
//
// The capability list is derived — a point that needs a grant contributes it
// automatically, so `required` here is only for things that are not extension
// points.
const MANIFEST = sdk.manifest.build(.{
    .name = "@@NAME@@",
    .version = "0.1.0",
    .points = &.{"lifecycle.register"},
    .modules = &.{"carbon:@@NAME@@"},
});

pub fn carbon_plugin_manifest() callconv(.c) [*:0]const u8 {
    return MANIFEST;
}
comptime {
    sdk.ext.implementManifest(carbon_plugin_manifest);
}

// ── lifecycle.register ──────────────────────────────────────────────────────
//
// Called once, after the app bundle has been evaluated. Install JS globals,
// start threads, take handles.
//
// `pub`, not a bare `fn`: `sdk.ext.implement` below is what turns this into a
// real export in a standalone build; a static release build's generated
// umbrella instead reaches it through `@import`, which only works for `pub`
// declarations. Either way, `sdk.ext.implement` asserts that "lifecycle.
// register" is a real point AND that `carbon_plugin_register`'s signature
// matches what the registry expects for it — get either wrong and this fails
// to compile, which is the only way to catch it: a function that merely
// LOOKS right compiles perfectly and yields a plugin the runtime silently
// never calls.

pub fn carbon_plugin_register(app_raw: *sdk.RawApp) callconv(.c) void {
    const app = sdk.CarbonApp.fromRaw(app_raw);

    // A major ABI mismatch means the struct layout differs; every field read
    // after this point would be garbage. The loader checks it too, from the
    // manifest — this is the belt to that pair of braces.
    if (!app.abiCompatible()) return;

    _ = app.setGlobalString("hello_from_@@NAME@@", "@@NAME@@ plugin loaded");
}
comptime {
    sdk.ext.implement("lifecycle.register", carbon_plugin_register);
}

