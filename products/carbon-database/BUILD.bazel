load("//.tools/orchestration/bazel/bun:defs.bzl", "bun_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["composition/**/*.ts", "infrastructure/**/*.ts", "infrastructure/**/*.sql", "**/tsconfig.json"]),
)

bun_test(
    name = "rls_policy_test",
    entry = "tests/rls-policy.test.ts",
    srcs = [":srcs"],
)

bun_test(
    name = "rls_policy_integration_test",
    entry = "tests/rls-policy.integration.test.ts",
    srcs = [":srcs"],
    deps = ["//solutions/capabilities/cloud/identity:srcs", "//solutions/contracts/platform:srcs"],
)

bun_test(
    name = "native_tables_integration_test",
    entry = "tests/native-tables.integration.test.ts",
    srcs = [":srcs"],
    deps = ["//solutions/capabilities/cloud/data:srcs", "//solutions/capabilities/cloud/catalog:srcs", "//solutions/capabilities/cloud/identity:srcs", "//solutions/contracts/platform:srcs"],
)
