# Fill product database and object-store credentials before starting.
DATABASE_URL=
CONTROL_PLANE_URL=http://localhost:8080
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_BUCKET=carbon-database
PORT=54321

# Canonical lifecycle: see ../carbon-cloud/docs/service-lifecycle.md.
CARBON_INTERNAL_PLATFORM=disabled
CARBON_AUTHORITY_ORIGIN=http://localhost:8080
CARBON_ASSERTION_ISSUER=http://localhost:8080
CARBON_ASSERTION_TRUST_KEYS=[]

# Canonical blob storage. Requires the internal platform settings above.
# CARBON_BLOB_BUCKET must be private and must not be OBJECT_STORE_BUCKET.
# CARBON_DATABASE_PUBLIC_ORIGIN is this service's public origin, used in transfer addresses.
CARBON_BLOBS=disabled
# CARBON_BLOB_BUCKET=carbon-blobs
# CARBON_DATABASE_PUBLIC_ORIGIN=https://data.example.com
