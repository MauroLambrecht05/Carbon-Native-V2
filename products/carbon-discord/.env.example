# Required Discord application credentials.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Required. Carbon Discord intentionally serves exactly one guild.
DISCORD_GUILD_ID=

# Durable local state. Relative paths resolve from the bot working directory.
DISCORD_DATA_PATH=./data/carbon-discord.sqlite
AUDIT_RETENTION_DAYS=365

# Public resources. Leave unset until each HTTPS destination is authoritative.
GITHUB_REPO=
DOCS_URL=
STATUS_URL=
SECURITY_URL=
PRIVACY_URL=
SUPPORT_POLICY_URL=

# Server channels. All values are Discord snowflake IDs.
WELCOME_CHANNEL_ID=
VERIFICATION_CHANNEL_ID=
LOG_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
ISSUES_CHANNEL_ID=
SHOWCASE_REVIEW_CHANNEL_ID=
SHOWCASE_CHANNEL_ID=
HELP_FORUM_CHANNEL_IDS=

# Access and staff roles. Staff lists are comma-separated Discord role IDs.
MEMBER_ROLE_ID=
SUPPORT_ROLE_IDS=
MODERATOR_ROLE_IDS=
COMMUNITY_MANAGER_ROLE_IDS=
RELEASE_MANAGER_ROLE_IDS=

# Member-controlled notification roles.
ANNOUNCEMENTS_ROLE_ID=
RELEASES_ROLE_ID=
PREVIEW_ROLE_ID=
SECURITY_ROLE_ID=
EVENTS_ROLE_ID=

# Community safety. Discord's own AutoMod and Raid Protection should also be enabled.
MIN_ACCOUNT_AGE_HOURS=72
SHOWCASE_NOMINATION_THRESHOLD=3

# Optional internal startup notification. Prefer leaving this unset in production.
STARTUP_CHANNEL_ID=

# Container health endpoint. It is exposed only inside the Compose network.
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000

# Exit for Docker restart if Discord remains unavailable for this long.
DISCORD_UNREADY_RESTART_SECONDS=300
