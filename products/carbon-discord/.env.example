# From the Discord Developer Portal, General Information tab.
DISCORD_APPLICATION_ID=
# Bot tab: "Reset Token" if you don't have it handy.
DISCORD_BOT_TOKEN=
# Optional: a server ID, for instant command registration scoped to that
# server during development (composition/deploy-commands.ts). Omit for a
# global registration, which can take up to an hour to appear.
DISCORD_GUILD_ID=
# "owner/name", used by /github. Leave unset until there's a real public
# repository; the command replies gracefully rather than linking a 404.
GITHUB_REPO=
# A text channel ID. If set, presentation/events/diagnostics/ready.event.ts
# also posts there on every login. Unset = silent no-op, not an error.
STARTUP_CHANNEL_ID=
