{
  "name": "carbon-cloud",
  "version": "0.1.0",
  "description": "Carbon Cloud: build, sign, package, publish and serve updates for carbon apps.",
  "type": "module",
  "scripts": {
    "migrate": "bun ./composition/migrate.ts",
    "account-mail-worker": "bun ./composition/account-mail-worker.ts",
    "catalog-worker": "bun ./composition/catalog-worker.ts",
    "data-import-worker": "bun ./composition/data-import-worker.ts",
    "data-export-worker": "bun ./composition/data-export-worker.ts",
    "worker-lease-sweeper": "bun ./composition/worker-lease-sweeper.ts",
    "function-worker": "bun ./composition/function-worker.ts",
    "operator-admin": "bun ./composition/operator-admin.ts",
    "lifecycle-sweeper": "bun ./composition/lifecycle-sweeper.ts",
    "start": "bun ./main.ts",
    "dev:mock": "vite --config composition/vite.mock.config.ts",
    "build:mock": "vite build --config composition/vite.mock.config.ts",
    "preview:mock": "vite preview --config composition/vite.mock.config.ts --host 127.0.0.1 --port 5176 --strictPort",
    "dev:live": "vite --config composition/vite.live.config.ts",
    "build:live": "vite build --config composition/vite.live.config.ts",
    "typecheck:browser": "tsc -p presentation/tsconfig.json",
    "test:browser": "bun test tests/browser",
    "check:mock-assets": "node tests/browser/assets-smoke.mjs"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
