{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../composition/browser.tsx",
    "../composition/browser.live.tsx",
    "../composition/create-browser-services.ts",
    "../infrastructure/browser/**/*.ts"
  ]
}
