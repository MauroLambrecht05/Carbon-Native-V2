# Existing Cloud services
DATABASE_URL=postgres://carbon:replace-me@localhost:5432/carbon
PORT=8080
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY_ID=replace-me
OBJECT_STORE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORE_BUCKET=carbon-artifacts
OBJECT_STORE_PUBLIC_BASE_URL=http://localhost:9000/carbon-artifacts

# Explicit account API rollout; no email/mock fallback if configuration is absent.
CARBON_ACCOUNT_AUTH=disabled
CARBON_PUBLIC_ORIGIN=https://cloud.example.com
CARBON_TERMS_VERSION=2026-09-12
CARBON_ACCOUNT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
CARBON_ACCOUNT_EMAIL_FROM=Carbon <auth@example.com>

# Separate OAuth app for account identity, with this exact registered callback:
# ${CARBON_PUBLIC_ORIGIN}/platform/v1/auth/github/callback
CARBON_ACCOUNT_GITHUB=disabled
GITHUB_ACCOUNT_CLIENT_ID=
GITHUB_ACCOUNT_CLIENT_SECRET=

# Separate GitHub App for repository discovery, webhooks, and pull requests.
# Store the PKCS#8/PKCS#1 RSA key as a multiline secret or with escaped newlines.
CARBON_GITHUB_REPOSITORIES=disabled
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Self-hosted notification custody: generate independent 32-byte random keys.
# Hosted KMS custody remains a separate deployment gate.
CARBON_ACCOUNT_RATE_KEY=
CARBON_ACCOUNT_ACTIVE_KEY_ID=2026-09
CARBON_ACCOUNT_ENCRYPTION_KEYS={"2026-09":"REPLACE_WITH_BASE64_32_RANDOM_BYTES"}

# Versioned environment secrets. Keep this keyring separate from account mail.
# The local AES adapter is for self-hosting; hosted production uses KMS/HSM custody.
CARBON_SECRETS=disabled
CARBON_SECRET_ACTIVE_KEY_ID=2026-09
CARBON_SECRET_ENCRYPTION_KEYS={"2026-09":"REPLACE_WITH_ANOTHER_BASE64_32_RANDOM_BYTES"}

# Catalog worker: pinned owning-service origins, with no fallback adapter.
# Receiving lifecycle endpoints and their trust configuration must be deployed too.
CARBON_PROVISIONING_DATABASE_ORIGIN=
CARBON_PROVISIONING_REGISTRY_ORIGIN=
# Account-facing Database forwarding. Uses the same explicit signing configuration.
CARBON_DATA_DATABASE_ORIGIN=
# Durable import API and separately supervised data-import-worker.
# Uses the account envelope keyring, Database origin and assertion configuration.
CARBON_DATA_IMPORTS=disabled
# Explicit self-hosted Ed25519 PKCS#8 signing configuration. Do not commit keys.
# Hosted KMS/HSM signing is still a deployment gate.
CARBON_ASSERTION_KEY_ID=
CARBON_ASSERTION_PRIVATE_KEY=
CARBON_ASSERTION_KEY_NOT_BEFORE=
CARBON_ASSERTION_KEY_NOT_AFTER=

# Enables `cs_` credential exchange into 60-second request-bound Database JWTs.
CARBON_SERVICE_ACCOUNT_ASSERTIONS=disabled
# Enables `dc_` CLI credential exchange into the same narrowly bound JWT form.
CARBON_DEVICE_ASSERTIONS=disabled

# Wrapping-key custody for environment secrets: local (default, self-hosted
# keyring above) or aws-kms. Selecting aws-kms requires every variable below;
# there is no fallback to the local keyring.
CARBON_SECRET_CUSTODY=local
# CARBON_SECRET_KMS_REGION=eu-west-1
# CARBON_SECRET_KMS_KEYS={"2026-10":"arn:aws:kms:eu-west-1:111122223333:key/REPLACE"}
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

# Enrolled workers, leases and lease-bound secret delivery. Requires CARBON_SECRETS=enabled.
CARBON_WORKERS=disabled

# Deprecation stage for legacy cc_ organization tokens: issue (default, today's
# behavior), accept (signup closed), warn (Deprecation headers), reject (401).
CARBON_LEGACY_TOKENS=issue
# Optional date for the Sunset header in the warn stage.
# CARBON_LEGACY_TOKEN_SUNSET=2027-01-01

# Live authority endpoint: enable alongside account auth and provisioner signing.
# Trust only the public counterpart(s) of the worker's signing keys.
CARBON_INTERNAL_PLATFORM=disabled
CARBON_ASSERTION_ISSUER=
CARBON_ASSERTION_TRUST_KEYS=[]

# For explicit development only:
# NODE_ENV=development
# CARBON_PUBLIC_ORIGIN=http://localhost:8080
# CARBON_ACCOUNT_EMAIL_PROVIDER=development-inbox
# CARBON_ACCOUNT_INBOX_DIRECTORY=products/carbon-cloud/.account-inbox
