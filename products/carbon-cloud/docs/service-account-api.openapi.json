{
  "openapi": "3.1.0",
  "info": { "title": "Carbon service account API", "version": "1.0.0", "description": "Managed exact-scope service accounts and one-time automation credentials." },
  "servers": [{ "url": "/" }],
  "security": [{ "browserSession": [] }],
  "paths": {
    "/platform/v1/service-assertions": {
      "post": { "operationId": "exchangeServiceAccountAssertion", "security": [], "description": "Authenticates a Bearer cs_ credential and returns a 60-second Ed25519 assertion bound to one exact Database request.", "parameters": [{ "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^Bearer cs_[A-Za-z0-9_-]{43}$" } }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountAssertionExchange" } } } }, "responses": { "200": { "description": "Ephemeral request-bound bearer assertion", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountAssertionResponse" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "501": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    },
    "/platform/v1/service-registry-assertions": {
      "post": { "operationId": "exchangeServiceAccountRegistryAssertion", "security": [], "description": "Authenticates a Bearer cs_ credential and returns a 60-second Ed25519 assertion bound to one exact Registry request. Database requests and the Database audience are rejected here.", "parameters": [{ "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^Bearer cs_[A-Za-z0-9_-]{43}$" } }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountRegistryAssertionExchange" } } } }, "responses": { "200": { "description": "Ephemeral request-bound bearer assertion", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountAssertionResponse" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "501": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    },
    "/platform/v1/orgs/{orgId}/service-accounts": {
      "parameters": [{ "$ref": "#/components/parameters/OrgId" }],
      "get": { "operationId": "listServiceAccounts", "parameters": [{ "$ref": "organization-api.openapi.json#/components/parameters/Limit" }, { "$ref": "organization-api.openapi.json#/components/parameters/Cursor" }, { "$ref": "organization-api.openapi.json#/components/parameters/Sort" }], "responses": { "200": { "description": "Managed service-account page", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountPage" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" } } },
      "post": { "operationId": "createServiceAccount", "parameters": [{ "$ref": "#/components/parameters/MutationOrigin" }, { "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCreate" } } } }, "responses": { "201": { "description": "Service account created", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountReceipt" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "409": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    },
    "/platform/v1/orgs/{orgId}/service-accounts/{serviceAccountId}": {
      "parameters": [{ "$ref": "#/components/parameters/OrgId" }, { "$ref": "#/components/parameters/ServiceAccountId" }],
      "post": { "operationId": "commandServiceAccount", "description": "Updates, disables or enables with fresh live authority and revision matching.", "parameters": [{ "$ref": "#/components/parameters/MutationOrigin" }, { "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCommand" } } } }, "responses": { "200": { "description": "Updated service account", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountReceipt" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "404": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "409": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    },
    "/platform/v1/orgs/{orgId}/service-accounts/{serviceAccountId}/credentials": {
      "parameters": [{ "$ref": "#/components/parameters/OrgId" }, { "$ref": "#/components/parameters/ServiceAccountId" }],
      "get": { "operationId": "listServiceAccountCredentials", "parameters": [{ "$ref": "organization-api.openapi.json#/components/parameters/Limit" }, { "$ref": "organization-api.openapi.json#/components/parameters/Cursor" }, { "$ref": "organization-api.openapi.json#/components/parameters/Sort" }], "responses": { "200": { "description": "Credential metadata page", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialPage" } } } }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "404": { "$ref": "account-api.openapi.json#/components/responses/Error" } } },
      "post": { "operationId": "createServiceAccountCredential", "description": "Returns the new token exactly once.", "parameters": [{ "$ref": "#/components/parameters/MutationOrigin" }, { "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialCreate" } } } }, "responses": { "201": { "description": "Credential metadata and only token disclosure", "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialIssue" } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "404": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "409": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    },
    "/platform/v1/orgs/{orgId}/service-accounts/{serviceAccountId}/credentials/{credentialId}": {
      "parameters": [{ "$ref": "#/components/parameters/OrgId" }, { "$ref": "#/components/parameters/ServiceAccountId" }, { "$ref": "#/components/parameters/CredentialId" }],
      "post": { "operationId": "commandServiceAccountCredential", "description": "Rotates with bounded overlap or revokes immediately.", "parameters": [{ "$ref": "#/components/parameters/MutationOrigin" }, { "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialCommand" } } } }, "responses": { "200": { "description": "Rotate returns a one-time issue; revoke returns safe metadata", "content": { "application/json": { "schema": { "anyOf": [{ "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialIssue" }, { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ServiceAccountCredentialReceipt" }] } } } }, "400": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "401": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "403": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "404": { "$ref": "account-api.openapi.json#/components/responses/Error" }, "409": { "$ref": "account-api.openapi.json#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "browserSession": { "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession" } },
    "parameters": {
      "OrgId": { "name": "orgId", "in": "path", "required": true, "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id" } },
      "ServiceAccountId": { "name": "serviceAccountId", "in": "path", "required": true, "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id" } },
      "CredentialId": { "name": "credentialId", "in": "path", "required": true, "schema": { "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id" } },
      "MutationOrigin": { "$ref": "account-api.openapi.json#/components/parameters/Origin" },
      "CsrfToken": { "$ref": "account-api.openapi.json#/components/parameters/CsrfToken" },
      "IdempotencyKey": { "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey" },
      "IfMatch": { "$ref": "account-api.openapi.json#/components/parameters/IfMatch" },
      "RequestId": { "$ref": "account-api.openapi.json#/components/parameters/RequestId" }
    }
  }
}
