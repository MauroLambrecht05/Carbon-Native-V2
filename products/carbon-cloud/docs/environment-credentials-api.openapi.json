{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon environment credentials API",
    "version": "1.0.0",
    "description": "Account-managed, environment-scoped automation credentials. Plaintext tokens are disclosed only by the successful create or rotate response and are never recoverable."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "browserSession": []
    }
  ],
  "paths": {
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/credentials": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listEnvironmentCredentials",
        "description": "Requires metadata.read for the exact environment. Returns metadata, prefix, status, expiry and last-use time; never a token or hash.",
        "parameters": [
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Limit"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Cursor"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Sort"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded credential metadata page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialPage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createEnvironmentCredential",
        "description": "Requires resources.configure, every delegated permission, fresh authentication, CSRF and the current environment revision. Idempotency prevents duplicate issuance but cannot redisclose a token after the first response.",
        "parameters": [
          {
            "$ref": "account-api.openapi.json#/components/parameters/Origin"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/CsrfToken"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IfMatch"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Credential metadata plus the only disclosure of this token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialIssue"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/credentials/{credentialId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "$ref": "#/components/parameters/CredentialId"
        }
      ],
      "post": {
        "operationId": "commandEnvironmentCredential",
        "description": "Rotates with at most 24 hours of overlap or revokes immediately. Requires fresh resources.configure authority and the current credential revision. Exact revoke retries return the original safe receipt; rotate retries cannot redisclose the issued token.",
        "parameters": [
          {
            "$ref": "account-api.openapi.json#/components/parameters/Origin"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/CsrfToken"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IfMatch"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rotate returns a one-time issue; revoke returns metadata and a safe message",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialIssue"
                    },
                    {
                      "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentCredentialReceipt"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession"
      }
    },
    "parameters": {
      "OrgId": {
        "name": "orgId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "EnvironmentId": {
        "name": "environmentId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "CredentialId": {
        "name": "credentialId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      }
    }
  }
}
