{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon Cloud releases and channels",
    "version": "1.0.0",
    "description": "Immutable releases over verified build artifacts, signed channel revisions, and the public update feed installed apps read. See releases.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/signing-profiles": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listSigningProfiles",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signing profiles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/SigningProfileList"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createSigningProfile",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Binds an environment secret holding an Ed25519 private key. Only the public key is recorded. Needs signing.manage.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/SigningProfileCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/SigningProfile"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "429": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/releases": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listReleases",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Releases",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ReleasePage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createRelease",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Publishes a release from a succeeded build. Cloud reads each chosen artifact back, checks it still matches the build's digest, and signs it. 409 when the build has not succeeded, the version was used, an artifact changed, or the signing secret no longer holds the profile's key. 503 when storage cannot be reached.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ReleaseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ReleaseReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "503": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/releases/{releaseId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "name": "releaseId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
          }
        }
      ],
      "get": {
        "operationId": "readRelease",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Release"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "withdrawRelease",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Withdraws the release: it joins the stop list and every channel offering it moves back to the last published release it offered, in one transaction. Nothing installed is recalled.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "The revision the caller last saw.",
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ReleaseCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The withdrawn release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ReleaseReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/channels": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listChannels",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Channels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelList"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/channels/{channel}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "name": "channel",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelName"
          }
        }
      ],
      "get": {
        "operationId": "readChannel",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The channel and its latest 100 revisions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelDetails"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "moveChannel",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "publish points the channel at a release and creates the channel if needed; rollout changes the percentage offered the current release. Each creates a new immutable, signed revision. If-Match is required once the channel exists.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "The revision the caller last saw."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "429": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/updates/v1/{feed}/{channel}/manifest.json": {
      "parameters": [
        {
          "name": "feed",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        {
          "name": "channel",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelName"
          }
        }
      ],
      "get": {
        "operationId": "readUpdateManifest",
        "security": [],
        "description": "The current revision's manifest, exactly as signed. 404 when the channel offers nothing or the environment is not active.",
        "responses": {
          "200": {
            "description": "The manifest",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Nothing at this address"
          }
        }
      }
    },
    "/updates/v1/{feed}/{channel}/manifest.sig": {
      "parameters": [
        {
          "name": "feed",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        {
          "name": "channel",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelName"
          }
        }
      ],
      "get": {
        "operationId": "readUpdateManifestSignature",
        "security": [],
        "description": "Ed25519 signature over the manifest bytes, standard base64.",
        "responses": {
          "200": {
            "description": "The signature",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=60"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Nothing at this address"
          }
        }
      }
    },
    "/updates/v1/{feed}/{channel}/yanked.json": {
      "parameters": [
        {
          "name": "feed",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        {
          "name": "channel",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/ChannelName"
          }
        }
      ],
      "get": {
        "operationId": "readUpdateStopList",
        "security": [],
        "description": "Withdrawn versions of the environment. Served even when the channel offers nothing.",
        "responses": {
          "200": {
            "description": "The stop list",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Nothing at this address"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "OrgId": {
        "name": "orgId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "EnvironmentId": {
        "name": "environmentId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      }
    },
    "securitySchemes": {
      "browserSession": {
        "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession"
      },
      "workerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A wc_ worker credential."
      }
    }
  }
}
