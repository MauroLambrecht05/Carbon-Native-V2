{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon build API",
    "version": "1.0.0",
    "description": "Creating, following and cancelling builds, and the worker protocol for running one on a lease."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/builds": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listBuilds",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Limit"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Cursor"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Sort"
          }
        ],
        "responses": {
          "200": {
            "description": "Builds of the environment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildPage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createBuild",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Stores the immutable input, reserves quota and grants the worker lease in one transaction. Requires release.publish.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MutationOrigin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The queued build",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "429": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/builds/{buildId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "$ref": "#/components/parameters/BuildId"
        }
      ],
      "get": {
        "operationId": "getBuild",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The build and the successful attempt's artifacts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildDetails"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "commandBuild",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "cancel. Requires being the creator or holding build.cancel.any.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MutationOrigin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The cancelled build",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/builds/{buildId}/logs": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "$ref": "#/components/parameters/BuildId"
        }
      ],
      "get": {
        "operationId": "readBuildLogs",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Log segments after a sequence number, in order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildLogPage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/builds/{buildId}/provenance": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        },
        {
          "$ref": "#/components/parameters/BuildId"
        }
      ],
      "get": {
        "operationId": "readBuildProvenance",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "What a succeeded build was made from and what it produced: the immutable input, the materials the worker reported, and the artifacts Cloud read back from object storage. The signature, when present, is Ed25519 over the UTF-8 bytes of the statement serialized exactly as returned. A build that has not succeeded has no provenance.",
        "responses": {
          "200": {
            "description": "The build's provenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildProvenance"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/worker/v1/leases/{leaseId}/build": {
      "post": {
        "operationId": "getWorkerBuildInput",
        "security": [
          {
            "workerCredential": []
          }
        ],
        "description": "The immutable build input for a held build lease. The first call starts the attempt.",
        "parameters": [
          {
            "$ref": "#/components/parameters/LeaseId"
          },
          {
            "$ref": "#/components/parameters/LeaseToken"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "The build input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/WorkerBuildInput"
                }
              }
            }
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "501": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/worker/v1/leases/{leaseId}/build/logs": {
      "post": {
        "operationId": "appendWorkerBuildLog",
        "security": [
          {
            "workerCredential": []
          }
        ],
        "description": "Appends the next log segment. Resending a stored segment with identical content is accepted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/LeaseId"
          },
          {
            "$ref": "#/components/parameters/LeaseToken"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildLogAppend"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The next expected sequence number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nextLogSequence"
                  ],
                  "properties": {
                    "nextLogSequence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "429": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/worker/v1/leases/{leaseId}/build/artifacts": {
      "post": {
        "operationId": "declareWorkerBuildArtifact",
        "security": [
          {
            "workerCredential": []
          }
        ],
        "description": "Declares one output. The object key must be under artifacts/{buildId}/{attempt}/.",
        "parameters": [
          {
            "$ref": "#/components/parameters/LeaseId"
          },
          {
            "$ref": "#/components/parameters/LeaseToken"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildArtifactDeclare"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The declared artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/BuildArtifact"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/worker/v1/leases/{leaseId}/build/complete": {
      "post": {
        "operationId": "completeWorkerBuild",
        "security": [
          {
            "workerCredential": []
          }
        ],
        "description": "Reports the build's outcome. A success carries the materials the worker built from and is accepted only after Cloud has read every declared artifact back from object storage and matched its size and SHA-256, and only when the built commit is the commit in the input. A refusal leaves the build running.",
        "parameters": [
          {
            "$ref": "#/components/parameters/LeaseId"
          },
          {
            "$ref": "#/components/parameters/LeaseToken"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/WorkerBuildComplete"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The finished build",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Build"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "503": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession"
      },
      "workerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A wc_ worker credential."
      }
    },
    "parameters": {
      "OrgId": {
        "name": "orgId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "EnvironmentId": {
        "name": "environmentId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "BuildId": {
        "name": "buildId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "LeaseId": {
        "name": "leaseId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "LeaseToken": {
        "name": "x-carbon-lease-token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^wl_[A-Za-z0-9_-]{43}$"
        }
      },
      "MutationOrigin": {
        "$ref": "account-api.openapi.json#/components/parameters/Origin"
      },
      "CsrfToken": {
        "$ref": "account-api.openapi.json#/components/parameters/CsrfToken"
      },
      "IdempotencyKey": {
        "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey"
      },
      "IfMatch": {
        "$ref": "account-api.openapi.json#/components/parameters/IfMatch"
      },
      "RequestId": {
        "$ref": "account-api.openapi.json#/components/parameters/RequestId"
      }
    }
  }
}
