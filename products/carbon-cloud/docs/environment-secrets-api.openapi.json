{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon environment secrets API",
    "version": "1.0.0",
    "description": "Metadata-only account API for versioned, envelope-encrypted environment secrets. Stored values are never returned."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "browserSession": []
    }
  ],
  "paths": {
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/secrets": {
      "parameters": [
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/OrgId"
        },
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/ProjectId"
        },
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listEnvironmentSecrets",
        "description": "Requires metadata.read for the exact environment. Returns names, states and revisions without encrypted or plaintext values.",
        "parameters": [
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Limit"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Cursor"
          },
          {
            "$ref": "organization-api.openapi.json#/components/parameters/Sort"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded metadata page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentSecretPage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "501": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createEnvironmentSecret",
        "description": "Requires fresh resources.configure authority, CSRF, idempotency and the current environment revision. The value is write-only and the response is metadata-only.",
        "parameters": [
          {
            "$ref": "account-api.openapi.json#/components/parameters/Origin"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/CsrfToken"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IfMatch"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentSecretCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/SecretReceipt"
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "501": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/projects/{projectId}/environments/{environmentId}/secrets/{secretId}": {
      "parameters": [
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/OrgId"
        },
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/ProjectId"
        },
        {
          "$ref": "environment-credentials-api.openapi.json#/components/parameters/EnvironmentId"
        },
        {
          "name": "secretId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
          }
        }
      ],
      "post": {
        "operationId": "commandEnvironmentSecret",
        "description": "Creates a new immutable encrypted version, or disables/enables materialization. Requires fresh resources.configure authority and the current secret revision.",
        "parameters": [
          {
            "$ref": "account-api.openapi.json#/components/parameters/Origin"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/CsrfToken"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/IfMatch"
          },
          {
            "$ref": "account-api.openapi.json#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentSecretCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SecretReceipt"
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "409": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "500": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "501": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession"
      }
    },
    "responses": {
      "SecretReceipt": {
        "description": "Metadata-only durable receipt",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/EnvironmentSecretReceipt"
            }
          }
        }
      }
    }
  }
}
