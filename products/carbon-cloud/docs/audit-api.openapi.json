{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon audit and event stream API",
    "version": "1.0.0",
    "description": "Browsing and live streaming of an organization's event log."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "browserSession": []
    }
  ],
  "paths": {
    "/platform/v1/orgs/{orgId}/audit": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "listAuditEvents",
        "description": "Newest first. Requires audit.read at the requested scope. The cursor is bound to the session, its permission revision and the scope.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of audit entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/AuditPage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/platform/v1/orgs/{orgId}/events/stream": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrgId"
        },
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/EnvironmentId"
        }
      ],
      "get": {
        "operationId": "streamEvents",
        "description": "Server-sent events. Each frame's data is a SubscriptionMessage and its id is the cursor. Ends with authorization_revoked when access is lost and with closed after 15 minutes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An event stream of SubscriptionMessage frames",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/SubscriptionMessage"
                }
              }
            }
          },
          "400": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "401": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "403": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          },
          "404": {
            "$ref": "account-api.openapi.json#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "$ref": "account-api.openapi.json#/components/securitySchemes/browserSession"
      }
    },
    "parameters": {
      "OrgId": {
        "name": "orgId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "EnvironmentId": {
        "name": "environmentId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "../../../solutions/contracts/platform/schema/platform.schema.json#/$defs/Id"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
