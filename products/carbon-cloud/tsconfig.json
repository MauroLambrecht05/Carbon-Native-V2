{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-mock", "presentation", "infrastructure/browser", "composition/browser.tsx", "composition/create-browser-services.ts", "composition/vite.mock.config.ts", "tests/browser"]
}
