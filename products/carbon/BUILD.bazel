# Carbon Native V2 - carbon
#
# The two shipped runtime binaries. One Cargo package, two [[bin]] targets —
# see Cargo.toml for why they cannot be split.

package(default_visibility = ["//visibility:public"])

load("//.tools/orchestration/bazel/cargo:defs.bzl", "cargo_binary", "cargo_test")

# Structured by concern — composition/ and presentation/ — not by binary. Both
# entry points live in composition/; see README.md for why there is no mini/ or
# blitz/ directory.
filegroup(
    name = "srcs",
    srcs = glob(
        ["composition/**/*.rs", "presentation/**/*.rs", "*.rs", "Cargo.toml"],
        allow_empty = True,
    ),
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**"], allow_empty = True),
)

# `snapshot` rides along with mini because it is what links the binary at a
# constant base (/DYNAMICBASE:NO — see build.rs), which the heap snapshot's
# absolute code pointers require. V1's justfile builds it the same way.
cargo_binary(
    name = "mini",
    package = "carbon-runtime",
    bin = "carbon-mini",
    crate_features = [
        "mini",
        "snapshot",
    ],
    srcs = [":srcs"],
)

cargo_binary(
    name = "blitz",
    package = "carbon-runtime",
    bin = "carbon-blitz",
    crate_features = ["blitz"],
    srcs = [":srcs"],
)

# The test the migration is verified against: start the real binary against a
# real bundle and watch it reach first paint.
#
# Six assertions, and the one that earns its keep is the phase sequence — 27
# names in a fixed order that encodes the startup dependency graph. mini.rs
# used to be a single 2,300-line file holding that whole sequence plus the
# event loop; it's now composition/mini.rs (bootstrap: window, softbuffer,
# JS runtime, host imports, bundle eval — ~800 lines), composition/cli.rs
# (argv parsing + the --compile-bundle/--snapshot-* build-time dispatch),
# and composition/run_loop.rs (the winit/tao event loop's match arms, the
# single largest piece). This test is exactly why that split was safe:
# reordering any of it is exactly how it goes wrong, and this is what
# would catch it.
#
# It needs no display: the runtime paints into a softbuffer surface and
# CARBON_TEST_EXIT_MS brings it down cleanly.
# size = "large" (900s, default is "medium"/300s): TIMEOUT at exactly 300.1s
# on a real CI run under full workspace parallelism (bazel test //... runs
# ~30 actions at once) — this compiles and launches the real runtime binary,
# not something a bigger budget papers over incorrectly.
cargo_test(
    name = "launch_test",
    package = "carbon-runtime",
    crate_features = [
        "mini",
        "snapshot",
    ],
    srcs = [
        ":srcs",
        ":tests",
    ],
    size = "large",
)
